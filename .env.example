# NAVI environment contract
#
# Production and dev/test MUST use different Supabase projects.
# Automated tests and destructive tooling refuse to run against the production
# project unless NAVI_ALLOW_PRODUCTION_TEST_WRITES=<project-ref> is set for a
# deliberately approved scoped verification.
#
# The production project ref is hard-coded in:
#   src/lib/env-safety.ts
#   e2e/support/campus-guard.mjs
#
# Copy to `.env.local` for local development and fill in a NON-PRODUCTION
# project. `.env.local` is gitignored.

# ── Supabase (required) ─────────────────────────────────────────────
# Two credentials are required, and they are NOT interchangeable.
#
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  browser + public read + auth session.
#                                      Server-side public clients and auth
#                                      middleware also use this. Safe to ship to
#                                      the browser — that is its purpose.
#   SUPABASE_SECRET_KEY                  privileged, server-only. RLS-bypassing
#                                      route handlers. MUST NOT appear under a
#                                      NEXT_PUBLIC_* name.
#
# The legacy JWT `anon` and `service_role` API keys are no longer supported and
# have no fallback in code. If either modern key is missing, the app fails closed
# with a message naming the variable — it will not silently degrade to a legacy key.
#
# Development / test project (NEVER production for dev or E2E):
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<dev-publishable-key>
SUPABASE_SECRET_KEY=<dev-secret-key>
SUPABASE_PROJECT_REF=<dev-project-ref>
SUPABASE_JWKS_URL=https://<dev-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Optional: retained for JWKS/third-party tooling. Not read by the app's
# credential resolvers.
SUPABASE_PUBLISHABLE_KEY=<dev-publishable-key>

# Supabase Management API (only needed for `supabase` CLI operations such as
# applying migrations). Never commit a real token.
SUPABASE_ACCESS_TOKEN=

# ── E2E ─────────────────────────────────────────────────────────────
# Required by every automated browser run. Must be a disposable campus id that
# is NOT map-map-1-k6bv.
E2E_CAMPUS_ID=

# ── Auth / app ──────────────────────────────────────────────────────
NEXT_PUBLIC_MOCK_AUTH=true
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── Cloudinary (optional for local UI work) ─────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── GitHub (optional) ───────────────────────────────────────────────
GITHUB_TOKEN=
